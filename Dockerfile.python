FROM python:3.12-slim

LABEL org.opencontainers.image.title="mad4hatter-drugres/python-scripts"
LABEL org.opencontainers.image.description="Lightweight image containing only the plasmodiumdrugres python helper scripts"

# ops_utils (pyops-service-toolkit) is needed by resmarkers_to_terra.py to write to Terra.
# git is only needed to install it, so it is removed afterwards.
RUN apt-get update && \
    apt-get install -yq --no-install-recommends git ca-certificates && \
    pip install --no-cache-dir "git+https://github.com/broadinstitute/pyops-service-toolkit.git@v12.20.0#egg=pyops-service-toolkit" && \
    apt-get purge -yq git && apt-get autoremove -yq && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -c "import ops_utils"

COPY python/*.py /opt/python-scripts/
RUN chmod +x /opt/python-scripts/*.py

ENV PATH="/opt/python-scripts:$PATH"
